# Copy to .env (which .gitignore must cover) — a token in the repo is a rotated token.
ENV=dev
APP_VERSION=0.1.0-dev
LOG_MESSAGE_TEXT=0          # refused in prod: message text is PII

BOT_TOKEN=
STICKER_OWNER_USER_ID=      # service account that owns the emoji set, NOT a person

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=

# Webhook (leave WEBHOOK_URL empty for polling in dev; polling must be single-instance)
WEBHOOK_URL=
WEBHOOK_SECRET=             # required with WEBHOOK_URL: without it the endpoint is public

# Mini App
WEBAPP_URL=
SESSION_SECRET=
SESSION_TTL_SEC=3600

ADMIN_IDS=
